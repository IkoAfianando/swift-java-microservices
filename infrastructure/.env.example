# ============================================================
# Database
# ============================================================
POSTGRES_USER=research
POSTGRES_PASSWORD=research_secret_2025
POSTGRES_DB=microservices_db
POSTGRES_PORT=5433  # Changed from 5432 to avoid conflict with existing local PostgreSQL

# Per-service databases (auto-created via init scripts)
USER_DB=user_service_db
PRODUCT_DB=product_service_db
ORDER_DB=order_service_db

# ============================================================
# Redis
# ============================================================
REDIS_PORT=6380  # Changed from 6379 to avoid conflict with existing local Redis
REDIS_PASSWORD=

# ============================================================
# Swift Services
# ============================================================
SWIFT_USER_PORT=8081
SWIFT_PRODUCT_PORT=8082
SWIFT_ORDER_PORT=8083
SWIFT_ENV=development

# ============================================================
# Java Services
# ============================================================
JAVA_USER_PORT=9081
JAVA_PRODUCT_PORT=9082
JAVA_ORDER_PORT=9083
SPRING_PROFILES_ACTIVE=docker

# ============================================================
# Monitoring
# ============================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000

PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

LOKI_PORT=3100
ALERTMANAGER_PORT=9093

CADVISOR_PORT=8080
NODE_EXPORTER_PORT=9100
